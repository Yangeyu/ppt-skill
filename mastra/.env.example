# Alibaba Cloud DashScope key — powers model "alibaba-cn/qwen3.7-plus".
# The Mastra model router reads this variable automatically.
# (If it is already exported in your shell, no .env file is needed.)
DASHSCOPE_API_KEY=sk-your-dashscope-key

