{% extends "base.html.j2" %}
{% from "_brush.html.j2" import brush, chip with context %}
{% block frame %}
{# 收尾 — 满幅笔刷回应封面 + 居中致谢 + 陶土橙联系 chip #}
{{ brush('brush-cross', 560, 'left:-120px;top:-90px;') }}
{{ brush('brush-br', 300, 'right:-50px;bottom:-56px;', 300) }}
<div class="m-out-frame">
  <div data-ppt="text" class="m-sec-kick">THANK YOU FOR YOUR SUPPORT AND TRUST</div>
  <div class="m-out-title-row">
    {% for seg in d.title|marksplit %}
    <div data-ppt="text" class="m-out-title"{% if seg.mark %} style="color:{{ colors['accent'] }};"{% endif %}>{{ seg.text }}</div>
    {% endfor %}
  </div>
  {% if d.subtitle %}<div data-ppt="text" class="m-out-sub">{{ d.subtitle }}</div>{% endif %}
  <div class="m-div">
    <div data-ppt="rect" class="m-div-line"></div>
    <div data-ppt="rect" class="m-div-dash"></div>
    <div data-ppt="rect" class="m-div-line"></div>
  </div>
  {% if d.contact %}{{ chip(d.contact) }}{% endif %}
</div>
{% include "_foot.html.j2" %}
{% endblock %}
