{% extends "base.html.j2" %}
{% from "_brush.html.j2" import corners with context %}
{% block frame %}
{# 台账表 — 暖纸头带 + 发丝线分行，首列灰蓝加重 #}
{{ corners(170) }}
<div class="m-frame">
  {% include "_head.html.j2" %}
  <div class="m-body">
    <div class="m-table">
      <div data-ppt="rect" class="m-trow m-thead">
        {% for h in d.headers %}
        <div class="m-tcell"><div data-ppt="text" class="m-tcell-h">{{ h }}</div></div>
        {% endfor %}
      </div>
      {% for row in d.rows %}
      <div class="m-trow">
        {% for cell in row %}
        <div class="m-tcell">
          <div data-ppt="text" class="m-tcell-t {{ 'lead-col' if loop.first else '' }}">{{ cell }}</div>
        </div>
        {% endfor %}
      </div>
      {% if not loop.last %}<div data-ppt="rect" class="m-trule"></div>{% endif %}
      {% endfor %}
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
