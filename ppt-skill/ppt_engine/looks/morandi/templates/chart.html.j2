{% extends "base.html.j2" %}
{% from "_brush.html.j2" import corners with context %}
{% block frame %}
{# 原生图表（驼×灰绿低饱和序列）+ 右侧 takeaway 暖纸卡（左陶土橙细条） #}
{{ corners(170) }}
<div class="m-frame">
  {% include "_head.html.j2" %}
  <div class="m-body" style="align-items:center;">
    <div class="m-chart-wrap">
      <div class="m-chart-area">
        <div data-ppt="chart" data-chart='{{ chart_json|safe }}' class="m-chart-box"></div>
      </div>
      {% if d.takeaway %}
      <div data-ppt="rect" class="m-take">
        <div data-ppt="rect" class="m-take-bar"></div>
        <div data-ppt="text" class="m-take-k">TAKEAWAY</div>
        <div data-ppt="text" class="m-take-text">{{ d.takeaway }}</div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
