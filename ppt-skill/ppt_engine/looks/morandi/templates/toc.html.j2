{% extends "base.html.j2" %}
{% from "_brush.html.j2" import brush with context %}
{% block frame %}
{# 目录 — 左笔刷艺术区叠「目录」大字，右侧圆chip中文数字列表（源模板 P2 构图） #}
{{ brush('brush-cross', 640, 'left:-90px;top:40px;') }}
<div data-ppt="text" class="m-toc-title">{{ d.title or '目录' }}</div>
{% set cn = ['壹','贰','叁','肆','伍','陆','柒','捌','玖','拾'] %}
{% set rot = [colors['tan'], colors['sage'], colors['pink'], colors['blue'], colors['gold'], colors['slate']] %}
<div class="m-toc">
  {% for it in d['items'] %}
  <div class="m-toc-item">
    <div class="m-toc-row">
      <div class="m-chip" style="width:40px;height:40px;">
        <div data-ppt="rect" style="position:absolute;inset:0;background:{{ rot[loop.index0 % 6] }};border-radius:50%;"></div>
        <div data-ppt="text" class="m-chip-num" style="font-size:16px;">{{ cn[loop.index0] }}</div>
      </div>
      <div class="m-toc-txt">
        <div data-ppt="text" class="m-toc-t">{{ it.title }}</div>
        {% if it.desc %}<div data-ppt="text" class="m-toc-d">{{ it.desc }}</div>{% endif %}
      </div>
      {% if it.pages %}<div data-ppt="text" class="m-toc-p">{{ it.pages }}</div>{% endif %}
    </div>
    {% if not loop.last %}<div data-ppt="rect" class="m-toc-rule"></div>{% endif %}
  </div>
  {% endfor %}
</div>
{% include "_foot.html.j2" %}
{% endblock %}
