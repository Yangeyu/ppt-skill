<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<style>
{% if fonts %}{% for fam in fonts.families %}
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 400; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.regular_b64 }}) format("truetype"); }
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 700; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.bold_b64 }}) format("truetype"); }
{% endfor %}{% endif %}
{{ css_vars|safe }}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
.slide {
  width: 1280px; height: 720px; position: relative; overflow: hidden;
  background: var(--bg-content); color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision;
}
[data-ppt] { box-sizing: border-box; }
/* riso text is single-line by design — keep it from re-wrapping in renderers
   whose substitute metrics differ from the browser measurement */
[data-ppt="text"] { margin: 0; padding: 0; white-space: nowrap; }

/* ---- shared content frame (zine header: blue bar w/ pink misregistration,
        mono kicker UNDER the title with a short underline — ppt-master p04/06/08) ---- */
.r-frame { position: absolute; inset: 0; padding: 46px 60px 40px; display: flex; flex-direction: column; }
.r-head { position: relative; flex: 0 0 auto; padding-left: 28px; }
.r-hbar-ghost { position: absolute; left: 5px; top: 7px; width: 12px; height: 46px; }
.r-hbar-main { position: absolute; left: 0; top: 2px; width: 12px; height: 46px; }
.r-title-wrap { position: relative; display: inline-block; }
.r-title { font-family: var(--font-display); font-weight: 400; font-size: 47px; line-height: .96;
           letter-spacing: .5px; white-space: nowrap; }
.r-kick-wrap { display: table; margin-top: 10px; }  /* table = 收缩适应且独占一行 */
.r-kicker { font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: .22em;
            text-transform: uppercase; color: var(--muted); }
.r-kick-rule { height: 2px; background: var(--ink); margin-top: 5px; }
.r-sub { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; letter-spacing: .16em;
         text-transform: uppercase; color: var(--muted); margin-top: 9px; }

/* ---- in-content illustration slots (the zine's picture channel) ---- */
.r-band { position: relative; height: 150px; margin-top: 20px; flex: 0 0 auto; }
.r-band-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.r-band-frame { position: absolute; inset: 0; border: 2px solid var(--ink); background: var(--paper-2); }
.r-band-img { position: absolute; inset: 2px; }
.r-illu-col { position: relative; flex: 0 0 316px; margin-right: 34px; }
.r-illu-col-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.r-illu-col-frame { position: absolute; inset: 0; border: 2px solid var(--ink); background: var(--paper-2); }
.r-illu-col-img { position: absolute; left: 2px; right: 2px; top: 2px; height: 392px; }
.r-illu-col-cap { position: absolute; left: 12px; bottom: 10px; font-family: var(--font-mono);
                  font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
                  color: var(--on-paper-muted); }

/* ---- icon grid ---- */
.r-grid { flex: 1 1 auto; display: grid; grid-template-columns: repeat(3, 1fr);
          grid-template-rows: repeat(2, 1fr); gap: 22px; margin-top: 24px; }
.r-cell { position: relative; }
.r-card-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.r-card { position: absolute; inset: 0; border: 2px solid var(--ink);
          padding: 17px 18px 15px; display: flex; flex-direction: column; }
.r-card-ico { width: 38px; height: 38px; }
.r-card-num { position: absolute; right: 13px; top: 9px; font-family: var(--font-display);
              font-weight: 400; font-size: 46px; line-height: 1; }
.r-card-meat { margin-top: 13px; flex: 1 1 auto; display: flex; flex-direction: column; }
.r-card-title { font-family: var(--font-display); font-weight: 400; font-size: 21px; line-height: 1.06; }
.r-card-sub { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .07em;
              text-transform: uppercase; margin-top: 6px; }
.r-card-tick { width: 22px; height: 3px; margin-top: 6px; }
.r-line { font-family: var(--font-body); font-size: 13px; line-height: 1.38; margin-top: 4px; }
.r-line.first { margin-top: 12px; }
.r-card-punch { font-family: var(--font-body); font-weight: 700; font-size: 13px; margin-top: auto; padding-top: 8px; }

/* ---- footer ---- */
.r-foot { position: absolute; left: 60px; right: 60px; bottom: 17px; display: flex;
          justify-content: space-between; align-items: baseline; }
.r-foot-t { font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; letter-spacing: .13em;
            text-transform: uppercase; color: var(--muted); }

/* ---- cover ---- */
.rc-frame { position: absolute; inset: 0; padding: 52px 60px 40px; }
.rc-tag { position: absolute; left: 60px; top: 50px; background: var(--blue); padding: 8px 14px; }
.rc-tag-t { font-family: var(--font-mono); font-size: 13px; font-weight: 700; letter-spacing: .2em;
            text-transform: uppercase; color: var(--bg-content); }
.rc-mark { position: absolute; right: 60px; top: 56px; font-family: var(--font-mono); font-size: 12.5px;
           font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
.rc-title-wrap { position: absolute; left: 60px; bottom: 150px; }
.rc-line { position: relative; display: inline-block; }
.rc-title { font-family: var(--font-display); font-weight: 400; font-size: 104px; line-height: .9;
            letter-spacing: 1px; display: block; white-space: nowrap; }
.rc-title.small { font-size: 76px; }
.rc-card-wrap { position: absolute; right: 60px; top: 150px; width: 320px; }
.rc-card-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.rc-card { position: relative; border: 2px solid var(--ink);
           background: var(--paper-2); padding: 22px 22px 20px; }
.rc-card-rule { width: 100%; height: 3px; background: var(--ink); }
.rc-sub { font-family: var(--font-body); font-size: 18px; font-weight: 700; line-height: 1.42;
          color: var(--ink); margin: 16px 0; }
.rc-card-foot { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .14em;
                text-transform: uppercase; color: var(--muted); }
.rc-foot { position: absolute; left: 60px; right: 60px; bottom: 34px; display: flex;
           justify-content: space-between; }
.rc-foot-t { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .14em;
             text-transform: uppercase; color: var(--muted); }
.rc-foot-rule { position: absolute; left: 60px; right: 60px; bottom: 60px; height: 2px; background: var(--ink); }
/* decorative riso color blocks (stand in for the screen-print hero) */
.rc-blocks { position: absolute; right: 96px; bottom: 250px; width: 300px; height: 200px; }
.rc-blk { position: absolute; }

/* ===== shared body ===== */
.r-body { flex: 1 1 auto; margin-top: 26px; display: flex; }

/* ===== toc / agenda (number chips w/ shadow + desc under title + page chips, zine p02) ===== */
.r-toc { width: 100%; display: flex; flex-direction: column; }
.r-toc-item { padding-top: 13px; }
.r-toc-row { display: flex; align-items: center; gap: 24px; }
.r-toc-chipwrap { position: relative; flex: 0 0 auto; width: 52px; height: 52px; }
.r-toc-chipshadow { position: absolute; inset: 0; transform: translate(4px, 4px); }
.r-toc-chip { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.r-toc-chip-t { font-family: var(--font-display); font-weight: 400; font-size: 26px; }
.r-toc-main { min-width: 0; }
.r-toc-title { font-family: var(--font-display); font-weight: 400; font-size: 25px; color: var(--ink); }
.r-toc-desc { font-family: var(--font-body); font-size: 13.5px; color: var(--on-paper-muted); margin-top: 5px; }
.r-toc-pgwrap { position: relative; margin-left: auto; flex: 0 0 auto; }
.r-toc-pgshadow { position: absolute; inset: 0; transform: translate(4px, 4px); }
.r-toc-pg { position: relative; padding: 6px 13px; }
.r-toc-pg-t { font-family: var(--font-mono); font-size: 11.5px; font-weight: 700; letter-spacing: .12em; }
.r-toc-rule { width: 100%; height: 2px; background: var(--ink); margin-top: 13px; }

/* ===== section / chapter divider (solid color) ===== */
.r-sec-frame { position: absolute; inset: 0; padding: 64px 60px; display: flex; flex-direction: column; justify-content: center; }
.r-sec-num { position: absolute; right: 40px; bottom: -30px; font-family: var(--font-display); font-weight: 400;
             font-size: 300px; line-height: .8; }
.r-sec-kick { font-family: var(--font-mono); font-size: 14px; font-weight: 700; letter-spacing: .2em;
              text-transform: uppercase; }
.r-sec-title { font-family: var(--font-display); font-weight: 400; font-size: 78px; line-height: .96; margin-top: 14px; }
.r-sec-tick { width: 84px; height: 7px; margin-top: 26px; }
.r-sec-sub { font-family: var(--font-mono); font-size: 15px; font-weight: 700; letter-spacing: .12em;
             margin-top: 24px; max-width: 640px; }

/* ===== checklist (chip rows, ppt-master zine how-to voice) ===== */
.r-vlist { width: 100%; display: flex; flex-direction: column; justify-content: space-evenly; }
.r-vrow { position: relative; display: flex; align-items: center; gap: 22px; padding: 12px 4px; }
.r-vrule { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ink); }
.r-vblock { position: absolute; inset: 4px -14px; }         /* emphasis row: solid ink slab */
.r-vchip { position: relative; flex: 0 0 auto; width: 46px; height: 46px;
  display: flex; align-items: center; justify-content: center; }
.r-vchip-t { font-family: var(--font-display); font-weight: 400; font-size: 23px; }
.r-vtext { font-family: var(--font-body); font-size: 20px; line-height: 1.4; color: var(--ink); }
.r-vtext.em { font-weight: 700; }

/* ===== bottom note bar (">_" annotation, the zine's black strip) ===== */
.r-note-wrap { position: relative; flex: 0 0 auto; margin-top: 22px; }
.r-note-shadow { position: absolute; inset: 0; transform: translate(5px, 5px); }
.r-note-bar { position: relative; display: flex; align-items: baseline; gap: 13px; padding: 12px 18px 11px; }
.r-note-k { font-family: var(--font-mono); font-weight: 700; font-size: 14px; letter-spacing: .08em; }
.r-note-t { font-family: var(--font-body); font-weight: 700; font-size: 16.5px; white-space: normal; flex: 1 1 auto; min-width: 0; }

/* ===== timeline v2 — cards hang alternately off the axis ===== */
.r-tl2 { position: relative; width: 100%; height: 100%; min-height: 380px; }
.r-tl2-axis { position: absolute; left: 8px; right: 8px; top: 50%; height: 4px; margin-top: -2px; background: var(--ink); }
.r-tl2-row { display: flex; gap: 22px; height: 100%; }
.r-tl2-item { flex: 1 1 0; position: relative; }
.r-tl2-dot { position: absolute; left: 50%; top: 50%; width: 15px; height: 15px;
  margin: -10px 0 0 -10px; border: 3px solid var(--ink); }
.r-tl2-cardwrap { position: absolute; left: 0; right: 0; }
.up .r-tl2-cardwrap { bottom: 57%; }
.down .r-tl2-cardwrap { top: 57%; }
.r-tl2-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
/* zine p04 two-part card: colored title strip + near-black body */
.r-tl2-chead { position: relative; border: 2px solid var(--ink); padding: 9px 12px 8px; text-align: center; }
.r-tl2-cbody { position: relative; border: 2px solid var(--ink); border-top: none; padding: 10px 12px 11px; }
.r-tl2-title { font-family: var(--font-display); font-weight: 400; font-size: 17.5px; line-height: 1.05; }
.r-tl2-desc { font-family: var(--font-body); font-size: 12.5px; line-height: 1.36; white-space: normal; }
.r-tl2-year { position: absolute; left: 2px; font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1; }
.up .r-tl2-year { top: 55.5%; margin-top: 14px; }
.down .r-tl2-year { bottom: 55.5%; margin-bottom: 14px; }

/* ===== closing stacked manifesto lines ===== */
.r-out-lines { display: flex; flex-direction: column; gap: 10px; }
.r-out-linewrap { position: relative; display: inline-block; align-self: flex-start; }
.r-out-line { font-family: var(--font-display); font-weight: 400; font-size: 84px; line-height: 1.0; }

/* ===== numbered steps (zine p06: colored number header + paper body, ">" seps) ===== */
.r-steps { width: 100%; display: flex; gap: 14px; align-items: stretch; }
.r-step-cell { flex: 1 1 0; position: relative; min-height: 220px; display: flex; flex-direction: column; }
.r-step-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.r-step-head { position: relative; border: 2px solid var(--ink); padding: 9px 13px 8px;
               display: flex; align-items: baseline; gap: 10px; }
.r-step-num { font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1; }
.r-step-klabel { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .1em;
                 text-transform: uppercase; }
.r-step-body { position: relative; flex: 1 1 auto; border: 2px solid var(--ink); border-top: none;
               background: var(--paper-2); padding: 14px 14px 12px; display: flex; flex-direction: column; }
.r-step-title { font-family: var(--font-display); font-weight: 400; font-size: 20px; color: var(--ink); }
.r-step-desc { font-family: var(--font-body); font-size: 13px; line-height: 1.42; margin-top: 9px; color: var(--ink); }
.r-step-sep { flex: 0 0 auto; align-self: center; font-family: var(--font-mono); font-weight: 700;
              font-size: 17px; color: var(--ink); }

/* ===== two columns — full-height misregistered panels, points spread ===== */
.r-cols { width: 100%; display: flex; gap: 40px; align-items: stretch; position: relative; }
.r-col { flex: 1 1 0; position: relative; }
.r-col-shadow { position: absolute; inset: 0; transform: translate(8px, 8px); }
.r-col-panel { position: relative; height: 100%; border: 3px solid var(--ink);
  background: var(--paper-2); padding: 30px 34px 26px;
  display: flex; flex-direction: column; }
.r-col-h { font-family: var(--font-display); font-weight: 400; font-size: 34px; }
.r-col-rule { width: 52px; height: 6px; margin: 14px 0 8px; }
.r-col-points { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: space-evenly; }
.r-col-row { display: flex; align-items: baseline; gap: 16px; }
.r-col-num { font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em;
  flex: 0 0 auto; }
.r-col-text { font-family: var(--font-body); font-size: 19px; line-height: 1.5; color: var(--ink); }
.r-col-foot { border-top: 2px solid var(--ink); padding-top: 10px; margin-top: 6px;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: .14em;
  color: var(--on-paper-muted); text-transform: uppercase; }
.r-cols-badge { position: absolute; left: 50%; top: 50%; width: 64px; height: 64px;
  transform: translate(-50%, -50%); border: 3px solid var(--ink);
  display: flex; align-items: center; justify-content: center; }
.r-cols-badge-t { font-family: var(--font-display); font-weight: 400; font-size: 26px;
  color: var(--ink); }

/* ===== comparison (two color-block cards, full height) ===== */
.r-cmp { width: 100%; display: flex; gap: 32px; align-items: stretch; position: relative; }
.r-cmp-cell { flex: 1 1 0; position: relative; }
.r-cmp-shadow { position: absolute; inset: 0; transform: translate(7px, 7px); }
.r-cmp-card { position: relative; height: 100%; border: 2px solid var(--ink);
  padding: 30px 32px 26px; display: flex; flex-direction: column; }
.r-cmp-h { font-family: var(--font-display); font-weight: 400; font-size: 32px; }
.r-cmp-rule { width: 46px; height: 5px; margin: 12px 0 6px; }
.r-cmp-points { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: space-evenly; }
.r-cmp-row { display: flex; align-items: flex-start; gap: 13px; }
.r-cmp-mark { width: 10px; height: 10px; margin-top: 8px; flex: 0 0 auto; }
.r-cmp-text { font-family: var(--font-body); font-size: 18px; line-height: 1.45; }

/* ===== kpi (big numbers) ===== */
.r-kpis { width: 100%; display: flex; gap: 26px; }
.r-kpi { flex: 1 1 0; position: relative; }
.r-kpi-top { width: 100%; height: 5px; background: var(--ink); }
.r-kpi-tick { position: absolute; left: 0; top: 0; width: 42px; height: 5px; }
.r-kpi-valwrap { position: relative; display: inline-block; margin-top: 22px; }
.r-kpi-val { font-family: var(--font-display); font-weight: 400; font-size: 76px; line-height: .9; }
.r-kpi-label { font-family: var(--font-display); font-weight: 400; font-size: 19px; margin-top: 14px; color: var(--ink); }
.r-kpi-delta { font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: .08em;
               text-transform: uppercase; margin-top: 9px; color: var(--muted); }

/* ===== chart ===== */
.r-chart-wrap { width: 100%; display: flex; gap: 40px; align-items: center; }
.r-chart-area { flex: 1 1 0; height: 350px; }
.r-chart-box { width: 100%; height: 100%; }
.r-take { flex: 0 0 296px; position: relative; }
.r-take-shadow { position: absolute; inset: 0; transform: translate(7px, 7px); }
.r-take-block { position: relative; border: 2px solid var(--ink); padding: 24px 24px 22px; }
.r-take-k { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
.r-take-text { font-family: var(--font-body); font-weight: 700; font-size: 19px; line-height: 1.4; margin-top: 12px; }

/* ===== quote ===== */
.r-quote-frame { position: absolute; inset: 0; padding: 74px 84px; display: flex; flex-direction: column; justify-content: center; }
.r-quote-mark { font-family: var(--font-display); font-weight: 400; font-size: 150px; line-height: .5; height: 76px; }
.r-quote-wrap { position: relative; display: inline-block; margin-top: 8px; }
.r-quote-text { font-family: var(--font-display); font-weight: 400; font-size: 50px; line-height: 1.12; max-width: 1000px; }
.r-quote-tick { width: 70px; height: 7px; margin: 30px 0 18px; }
.r-quote-attr { font-family: var(--font-mono); font-size: 16px; font-weight: 700; letter-spacing: .12em; }

/* ===== closing / outro ===== */
.r-out-frame { position: absolute; inset: 0; padding: 60px; display: flex; flex-direction: column; justify-content: center; }
.r-out-wrap { position: relative; display: inline-block; }
.r-out-title { font-family: var(--font-display); font-weight: 400; font-size: 92px; line-height: .98; }
.r-out-bar { display: inline-block; background: var(--ink); padding: 10px 16px; margin-top: 30px; }
.r-out-sub { font-family: var(--font-body); font-weight: 700; font-size: 19px; color: var(--bg-content); }
.r-out-contact { font-family: var(--font-mono); font-size: 13px; font-weight: 700; letter-spacing: .14em;
                 text-transform: uppercase; color: var(--muted); margin-top: 24px; }

/* ===== timeline ===== */
.r-tl { position: relative; width: 100%; }
.r-tl-axis { position: absolute; left: 28px; right: 28px; top: 70px; height: 4px; background: var(--ink); }
.r-tl-row { display: flex; gap: 14px; }
.r-tl-item { flex: 1 1 0; display: flex; flex-direction: column; align-items: flex-start; }
.r-tl-year { font-family: var(--font-display); font-weight: 400; font-size: 30px; line-height: 1; }
.r-tl-dot { width: 20px; height: 20px; border: 2px solid var(--ink); margin: 16px 0 0 4px; }
.r-tl-title { font-family: var(--font-display); font-weight: 400; font-size: 18px; margin-top: 16px; }
.r-tl-desc { font-family: var(--font-body); font-size: 12.5px; line-height: 1.38; margin-top: 7px; }

/* ===== table ===== */
.r-table { width: 100%; height: 100%; display: flex; flex-direction: column; }
.r-trow { display: flex; flex: 1 1 0; }
.r-trow.h-row { flex: 0 0 auto; }
.r-tcell { flex: 1 1 0; border: 1px solid var(--ink); padding: 10px 16px; display: flex; align-items: center; min-height: 44px; }
.r-tcell-t { font-family: var(--font-body); font-size: 15px; line-height: 1.3; color: var(--ink); }
.r-tcell.h { background: var(--blue); }
.r-tcell.h .r-tcell-t, .r-thead-t { font-family: var(--font-display); font-weight: 400; font-size: 15px; color: var(--bg-content); }

/* ===== pillars (zine p10: colored header bar + bordered paper body, full height) ===== */
.r-pillars { width: 100%; display: flex; gap: 22px; align-items: stretch; }
.r-pillar { flex: 1 1 0; position: relative; display: flex; flex-direction: column; }
.r-pillar-shadow { position: absolute; inset: 0; transform: translate(6px, 6px); }
.r-pillar-head { position: relative; border: 2px solid var(--ink); padding: 12px 16px 11px;
                 display: flex; align-items: baseline; gap: 10px; }
.r-pillar-h { font-family: var(--font-display); font-weight: 400; font-size: 24px; }
.r-pillar-tag { margin-left: auto; font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
                letter-spacing: .08em; text-transform: uppercase; }
.r-pillar-body { position: relative; flex: 1 1 auto; border: 2px solid var(--ink); border-top: none;
                 background: var(--paper-2); padding: 14px 16px 12px;
                 display: flex; flex-direction: column; justify-content: space-evenly; }
.r-pillar-row { display: flex; align-items: flex-start; gap: 12px; }
.r-pillar-mark { width: 9px; height: 9px; margin-top: 7px; flex: 0 0 auto; }
.r-pillar-text { font-family: var(--font-body); font-size: 15px; line-height: 1.4; color: var(--ink); }

/* body text that may run long must wrap (overrides the single-line default) */
.r-vtext, .r-col-text, .r-cmp-text, .r-step-desc, .r-take-text, .r-tcell-t,
.r-pillar-text, .rc-sub, .r-quote-text, .r-out-sub, .r-sec-sub, .r-tl-desc { white-space: normal; }
