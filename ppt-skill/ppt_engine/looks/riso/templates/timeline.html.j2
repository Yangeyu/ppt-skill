{% extends "base.html.j2" %}
{% block frame %}
<div class="r-frame">
  {% include "_head.html.j2" %}
  <div class="r-body" style="align-items:center;">
    <div class="r-tl">
      <div data-ppt="rect" class="r-tl-axis"></div>
      <div class="r-tl-row">
        {% for m in d.milestones %}
        {% set accent = [colors['blue'], colors['pink'], colors['mustard']][loop.index0 % 3] %}
        <div class="r-tl-item">
          <div data-ppt="text" class="r-tl-year" style="color:{{ accent }};">{{ m.year }}</div>
          <div data-ppt="rect" class="r-tl-dot" style="background:{{ accent }};"></div>
          <div data-ppt="text" class="r-tl-title">{{ m.title }}</div>
          {% if m.desc %}<div data-ppt="text" class="r-tl-desc">{{ m.desc }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
