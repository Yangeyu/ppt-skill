{% extends "base.html.j2" %}
{% block frame %}
{% set pal = [
  {'bg': colors['blue'],    'fg': colors['bg-content'], 'accent': colors['pink']},
  {'bg': colors['pink'],    'fg': colors['ink'],        'accent': colors['blue']},
  {'bg': colors['mustard'], 'fg': colors['ink'],        'accent': colors['ink']},
  {'bg': colors['ink'],     'fg': colors['bg-content'], 'accent': colors['pink']}
] %}
<div class="r-frame">
  {% include "_head.html.j2" %}
  <div class="r-body">
    <div class="r-pillars">
      {% for col in d.columns %}
      {% set c = pal[loop.index0 % 4] %}
      <div class="r-pillar">
        <div data-ppt="rect" class="r-pillar-head" style="background:{{ c.bg }};color:{{ c.fg }};">
          <div data-ppt="text" class="r-pillar-h" style="color:{{ c.fg }};">{{ col.heading }}</div>
          {% if col.tag %}<div data-ppt="text" class="r-pillar-tag" style="color:{{ c.accent }};">{{ col.tag }}</div>{% endif %}
        </div>
        <div class="r-pillar-body">
          {% for pt in col.points %}
          <div class="r-pillar-row">
            <div data-ppt="rect" class="r-pillar-mark" style="background:{{ c.bg }};"></div>
            <div data-ppt="text" class="r-pillar-text">{{ pt }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% include "_foot.html.j2" %}
</div>
{% endblock %}
