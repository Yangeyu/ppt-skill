{% extends "base.html.j2" %}
{% block frame %}
{# zine p06 工艺页:可选顶部插图横幅 + 彩色编号头 + 纸面正文卡,步骤间 ">" 连接 #}
{% set pal = [
  {'bg': colors['blue'],    'fg': colors['bg-content'], 'accent': colors['pink'],    'shadow': colors['pink']},
  {'bg': colors['pink'],    'fg': colors['ink'],        'accent': colors['blue'],    'shadow': colors['blue']},
  {'bg': colors['mustard'], 'fg': colors['ink'],        'accent': colors['ink'],     'shadow': colors['blue']},
  {'bg': colors['ink'],     'fg': colors['bg-content'], 'accent': colors['pink'],    'shadow': colors['pink']},
  {'bg': colors['blue'],    'fg': colors['bg-content'], 'accent': colors['mustard'], 'shadow': colors['pink']}
] %}
<div class="r-frame">
  {% include "_head.html.j2" %}
  {% include "_band.html.j2" %}
  <div class="r-body" style="align-items:center;">
    <div class="r-steps">
      {% for s in d.steps %}
      {% set c = pal[loop.index0 % 5] %}
      <div class="r-step-cell">
        <div data-ppt="rect" data-ppt-deco class="r-step-shadow" style="background:{{ c.shadow }};"></div>
        <div data-ppt="rect" data-ppt-z="1" class="r-step-head" style="background:{{ c.bg }};">
          <div data-ppt="text" data-ppt-z="2" class="r-step-num" style="color:{{ c.fg }};">{{ '%02d' % loop.index }}</div>
          <div data-ppt="text" data-ppt-z="2" class="r-step-klabel" style="color:{{ c.accent if c.bg != colors['mustard'] else colors['ink'] }};">STEP</div>
        </div>
        <div data-ppt="rect" data-ppt-z="1" class="r-step-body">
          <div data-ppt="text" data-ppt-z="2" class="r-step-title">{{ s.title }}</div>
          {% if s.desc %}<div data-ppt="text" data-ppt-z="2" class="r-step-desc">{{ s.desc }}</div>{% endif %}
        </div>
      </div>
      {% if not loop.last %}<div data-ppt="text" class="r-step-sep">&gt;</div>{% endif %}
      {% endfor %}
    </div>
  </div>
  {% include "_note.html.j2" %}
  {% include "_foot.html.j2" %}
</div>
{% endblock %}
