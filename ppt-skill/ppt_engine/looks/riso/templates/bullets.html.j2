{% extends "base.html.j2" %}
{% block frame %}
<div class="r-frame">
  {% include "_head.html.j2" %}
  <div class="r-body">
    <div class="r-vlist">
      {% for b in d.bullets %}
      {% set accent = [colors['blue'], colors['pink'], colors['mustard']][loop.index0 % 3] %}
      <div class="r-vrow">
        <div data-ppt="text" class="r-vnum" style="color:{{ accent }};">{{ '%02d' % loop.index }}</div>
        <div data-ppt="text" class="r-vtext {{ 'em' if b.emphasis else '' }}">{{ b.text }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
