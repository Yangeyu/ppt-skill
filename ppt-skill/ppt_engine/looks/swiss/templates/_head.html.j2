<div class="s-chrome">
  <div data-ppt="text" class="s-chrome-t">SWISS INTERNATIONAL</div>
  <div data-ppt="text" class="s-chrome-t">{{ '%02d / %02d'|format(page_no, page_total) if page_total else 'GRID 16 · IKB' }}</div>
</div>
<div data-ppt="rect" class="s-chrome-rule"></div>
<div class="s-head">
  {% if d.eyebrow %}<div data-ppt="text" class="s-kicker">{{ d.eyebrow }}</div>{% endif %}
  <div class="s-title-row">
    {% for seg in d.title|marksplit %}
    <div data-ppt="text" class="s-title"{% if seg.mark %} style="color:{{ colors['accent'] }};"{% endif %}>{{ seg.text }}</div>
    {% endfor %}
  </div>
  {% if d.subtitle is defined and d.subtitle %}<div data-ppt="text" class="s-sub">{{ d.subtitle }}</div>{% endif %}
</div>
