{% extends "base.html.j2" %}
{% block bg %}{% endblock %}
{% block frame %}
{# S01 Cover — IKB 满屏,反白细字重大标题(强调词斜体,蓝底不用蓝),底部发丝线 + 副标 #}
<div data-ppt="rect" data-ppt-z="-20" style="position:absolute;inset:0;background:{{ colors['accent'] }};"></div>
<div class="sc-frame">
  <div class="s-chrome">
    <div data-ppt="text" class="s-chrome-t" style="color:rgba(255,255,255,.62);">{{ d.eyebrow or 'SWISS INTERNATIONAL' }}</div>
    <div data-ppt="text" class="s-chrome-t" style="color:rgba(255,255,255,.62);">{{ '%02d / %02d'|format(page_no, page_total) if page_total else 'IKB · 002FA7' }}</div>
  </div>
  <div data-ppt="rect" class="s-chrome-rule" style="background:rgba(255,255,255,.24);"></div>
  <div style="flex:1 1 auto;display:flex;flex-direction:column;justify-content:center;">
    <div class="sc-title-row">
      {% for seg in d.title|marksplit %}
      <div data-ppt="text" class="sc-title" style="color:{{ colors['accent-on'] }};{% if seg.mark %}font-style:italic;{% endif %}">{{ seg.text }}</div>
      {% endfor %}
    </div>
  </div>
  <div data-ppt="rect" style="width:100%;height:1px;background:rgba(255,255,255,.24);"></div>
  <div style="display:flex;justify-content:space-between;align-items:baseline;padding-top:18px;">
    {% if d.subtitle %}<div data-ppt="text" style="font-family:var(--font-body);font-size:17px;line-height:1.5;color:rgba(255,255,255,.86);white-space:normal;max-width:720px;">{{ d.subtitle }}</div>{% endif %}
    <div data-ppt="text" class="s-chrome-t" style="color:rgba(255,255,255,.62);">{{ d.footer or '' }}</div>
  </div>
</div>
{% set foot_muted = 'rgba(255,255,255,.62)' %}
{% set foot_dot = 'rgba(255,255,255,.30)' %}
{% set foot_accent = '#FFFFFF' %}
{% include "_foot.html.j2" %}
{% endblock %}
