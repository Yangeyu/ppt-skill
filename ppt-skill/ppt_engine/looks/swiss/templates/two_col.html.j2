{% extends "base.html.j2" %}
{% block frame %}
{# 攻/防两卡 — 左 accent 卡(唯一焦点),右 grey-1 中性卡;直角纯色无阴影 #}
<div class="s-frame">
  {% include "_head.html.j2" %}
  <div class="s-body">
    <div class="s-cols">
      {% for col, bg, fg, sub in [(d.left, colors['accent'], colors['accent-on'], 'rgba(255,255,255,.66)'),
                                  (d.right, colors['grey-1'], colors['ink'], colors['grey-3'])] %}
      <div data-ppt="rect" class="s-col-card" style="background:{{ bg }};">
        <div data-ppt="text" class="s-col-h" style="color:{{ fg }};">{{ col.heading }}</div>
        <div data-ppt="rect" class="s-col-rule" style="background:{{ sub if loop.first else colors['grey-2'] }};"></div>
        <div class="s-col-points">
          {% for pt in col.points %}
          <div class="s-col-row">
            <div data-ppt="text" class="s-col-num" style="color:{{ sub }};">{{ '%02d'|format(loop.index) }}</div>
            <div data-ppt="text" class="s-col-text" style="color:{{ fg }};">{{ pt }}</div>
          </div>
          {% endfor %}
        </div>
        <div data-ppt="text" class="s-col-foot" style="color:{{ sub }};">{{ '%02d POINTS'|format(col.points|length) }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
