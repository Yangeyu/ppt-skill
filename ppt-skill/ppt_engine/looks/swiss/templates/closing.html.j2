{% extends "base.html.j2" %}
{% block frame %}
{# S10 Split Closing — 左墨色半屏反白宣言,右纸底联系信息;与 IKB 封面形成闭环 #}
<div data-ppt="rect" data-ppt-z="-20" style="position:absolute;left:0;top:0;width:56%;height:100%;background:{{ colors['ink'] }};"></div>
<div class="s-out-left">
  <div data-ppt="rect" style="width:10px;height:10px;background:{{ colors['accent'] }};margin-bottom:30px;"></div>
  <div class="s-out-title-row">
    {% for seg in d.title|marksplit %}
    <div data-ppt="text" class="s-out-title" style="color:{{ colors['on-dark'] }};{% if seg.mark %}font-style:italic;{% endif %}">{{ seg.text }}</div>
    {% endfor %}
  </div>
</div>
<div class="s-out-right">
  {% if d.subtitle %}<div data-ppt="text" class="s-out-sub">{{ d.subtitle }}</div>{% endif %}
  <div data-ppt="rect" style="width:34px;height:3px;background:{{ colors['accent'] }};margin-top:22px;"></div>
  {% if d.contact %}<div data-ppt="text" class="s-out-contact">{{ d.contact }}</div>{% endif %}
</div>
<div data-ppt="text" class="s-chrome-t" style="position:absolute;left:64px;bottom:32px;color:{{ colors['on-dark-muted'] }};">SWISS INTERNATIONAL</div>
<div data-ppt="text" class="s-chrome-t" style="position:absolute;right:64px;bottom:32px;">FIN</div>
{% endblock %}
