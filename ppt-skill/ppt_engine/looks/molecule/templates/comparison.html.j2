{% extends "base.html.j2" %}
{% block frame %}
{# 左右对比 — 中缝发丝线对开;右列为焦点侧(渐变标记),左列中性 #}
{% set grad = colors['primary']|replace('#','') ~ ',' ~ colors['primary-2']|replace('#','') ~ ',45' %}
<div class="mo-frame">
  {% include "_head.html.j2" %}
  <div class="mo-body">
    <div style="width:100%;display:flex;align-items:stretch;position:relative;">
      <div data-ppt="rect" style="position:absolute;left:50%;top:0;bottom:0;width:1px;background:var(--hairline);"></div>
      {% for col in [d.left, d.right] %}
      {% set focus = not loop.first %}
      <div style="flex:1 1 0;display:flex;flex-direction:column;{{ 'padding-right:44px;' if loop.first else 'padding-left:44px;' }}">
        <div data-ppt="text" class="mo-col-h">{{ col.heading }}</div>
        {% if focus %}
        <div data-ppt="rect" data-grad="{{ grad }}" class="mo-col-bar"></div>
        {% else %}
        <div data-ppt="rect" class="mo-col-bar" style="background:{{ colors['muted'] }};"></div>
        {% endif %}
        <div class="mo-col-points">
          {% for pt in col.points %}
          <div class="mo-col-row">
            <div data-ppt="rect" class="mo-col-mark" style="background:{{ colors['primary-2'] if focus else colors['muted'] }};"></div>
            <div data-ppt="text" class="mo-col-text">{{ pt }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% include "_sowhat.html.j2" %}
</div>
{% include "_foot.html.j2" %}
{% endblock %}
