<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<style>
{% if fonts %}{% for fam in fonts.families %}
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 400; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.regular_b64 }}) format("truetype"); }
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 700; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.bold_b64 }}) format("truetype"); }
{% endfor %}{% endif %}
{{ css_vars|safe }}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
.slide {
  width: 1280px; height: 720px; position: relative; overflow: hidden;
  background: var(--bg-content); color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision;
}
[data-ppt] { box-sizing: border-box; }
/* 大标题/角标单行为主 — 默认不折行,正文类在底部白名单放开 */
[data-ppt="text"] { margin: 0; padding: 0; white-space: nowrap; }

/* ---- shared content frame ---- */
.mo-frame { position: absolute; inset: 0; padding: 38px 64px 40px; display: flex; flex-direction: column; }
.mo-chrome { flex: 0 0 auto; display: flex; justify-content: space-between; align-items: baseline; }
.mo-chrome-t { font-family: var(--font-mono); font-size: 10.5px; font-weight: 400; letter-spacing: .18em;
               text-transform: uppercase; color: var(--muted); }
.mo-head { flex: 0 0 auto; margin-top: 26px; }
.mo-kick-row { display: flex; align-items: center; gap: 9px; }
.mo-kick-dot { width: 9px; height: 9px; border-radius: 50%;
               background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-kicker { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .2em;
             text-transform: uppercase; color: var(--primary); }
.mo-title-row { display: flex; align-items: baseline; margin-top: 12px; }
.mo-title { font-family: var(--font-display); font-weight: 400; font-size: 32px; line-height: 1.15;
            letter-spacing: .01em; color: var(--ink); }
.mo-sub { font-family: var(--font-body); font-size: 14px; color: var(--muted); margin-top: 10px; }
.mo-body { flex: 1 1 auto; margin-top: 30px; display: flex; min-height: 0; }
.mo-foot { position: absolute; left: 64px; right: 64px; bottom: 16px; display: flex;
           justify-content: space-between; align-items: baseline; }
.mo-foot-t { font-family: var(--font-mono); font-size: 10px; letter-spacing: .16em;
             text-transform: uppercase; color: var(--muted); }
/* so_what 收束条：淡紫底胶囊 + 渐变圆点 */
.mo-sowhat { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; margin-top: 16px;
             background: var(--tint); border-radius: 12px; padding: 10px 18px; }
.mo-sowhat-dot { width: 10px; height: 10px; border-radius: 50%; flex: 0 0 auto;
                 background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-sowhat-t { font-family: var(--font-body); font-weight: 700; font-size: 14px; line-height: 1.45;
               color: var(--ink); }

/* 渐变圆徽（序号）：整体走 data-ppt="icon" 元素截图烘焙（文字压渐变,原生锚点对不齐） */
.mo-badge { flex: 0 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, var(--primary), var(--primary-2));
            font-family: var(--font-mono); font-weight: 700; color: #FFFFFF; }

/* ===== toc（横排渐变圆徽,源模板 CONTENTS 页） ===== */
.mo-toc { width: 100%; display: flex; align-items: flex-start; gap: 18px; }
.mo-toc-item { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; }
.mo-toc-badge { width: 84px; height: 84px; font-size: 24px; }
.mo-toc-title { font-family: var(--font-display); font-weight: 400; font-size: 19px;
                color: var(--ink); margin-top: 22px; }
.mo-toc-desc { font-family: var(--font-body); font-size: 12.5px; line-height: 1.5; color: var(--muted);
               margin-top: 9px; text-align: center; max-width: 170px; }
.mo-toc-pages { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em;
                color: var(--primary-2); margin-top: 8px; }

/* ===== section（巨号编号 + 右侧气泡簇） ===== */
.mo-sec-frame { position: absolute; left: 64px; top: 0; width: 56%; height: 100%;
                display: flex; flex-direction: column; justify-content: center; }
.mo-sec-num { font-family: var(--font-display); font-weight: 400; font-size: 150px; line-height: .95;
              letter-spacing: -.01em; color: var(--ink); }
.mo-sec-bar { width: 64px; height: 7px; border-radius: 4px; margin-top: 26px;
              background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-sec-title { font-family: var(--font-display); font-weight: 400; font-size: 44px;
                color: var(--ink); margin-top: 26px; }
.mo-sec-sub { font-family: var(--font-body); font-size: 15px; line-height: 1.6; color: var(--muted); margin-top: 14px; }

/* ===== hero（圆形图窗 + 右侧陈述/事实栈） ===== */
.mo-hero-body { flex: 1 1 auto; margin-top: 24px; display: flex; align-items: center; gap: 56px; min-height: 0; }
.mo-hero-imgbox { flex: 0 0 auto; width: 400px; height: 400px; position: relative; }
.mo-hero-right { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.mo-hero-sub { font-family: var(--font-body); font-size: 16px; line-height: 1.7; color: var(--ink); }
.mo-hero-facts { display: flex; flex-direction: column; gap: 22px; margin-top: 34px; }
.mo-hero-fact { display: flex; align-items: baseline; gap: 16px; }
.mo-hero-fval { font-family: var(--font-display); font-weight: 400; font-size: 40px; line-height: 1;
                color: var(--primary-2); min-width: 128px; }
.mo-hero-flabel { font-family: var(--font-body); font-size: 14px; color: var(--muted); }

/* ===== kpi ===== */
.mo-kpis { width: 100%; display: flex; gap: 30px; align-items: stretch; }
.mo-kpi { flex: 1 1 0; display: flex; flex-direction: column; background: var(--surface);
          border-radius: 16px; padding: 26px 26px 22px; }
.mo-kpi-bar { width: 34px; height: 5px; border-radius: 3px;
              background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-kpi-val { font-family: var(--font-display); font-weight: 400; font-size: 54px; line-height: 1;
              letter-spacing: -.01em; color: var(--ink); margin-top: 24px; }
.mo-kpi-label { font-family: var(--font-body); font-weight: 700; font-size: 15px; color: var(--ink); margin-top: 14px; }
.mo-kpi-delta { font-family: var(--font-mono); font-size: 11.5px; font-weight: 700; letter-spacing: .06em;
                margin-top: 9px; }

/* ===== bullets（渐变圆徽序号行,可选左插图列） ===== */
.mo-illu-col { flex: 0 0 auto; width: 380px; height: 500px; position: relative; margin-right: 52px; align-self: center; }
.mo-vlist { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: space-evenly; min-width: 0; }
.mo-vrow { display: flex; align-items: flex-start; gap: 18px; }
.mo-vbadge { width: 30px; height: 30px; font-size: 12px; margin-top: 2px; }
.mo-vtext { font-family: var(--font-body); font-size: 17px; line-height: 1.55; color: var(--ink); margin-top: 3px; }
.mo-vtext.em { font-weight: 700; }
.mo-vrule { width: 100%; height: 1px; background: var(--hairline); margin: 13px 0 13px 48px; }

/* ===== chart ===== */
.mo-chart-wrap { width: 100%; display: flex; gap: 40px; align-items: center; }
.mo-chart-area { flex: 1 1 0; height: 370px; }
.mo-chart-box { width: 100%; height: 100%; }
.mo-take { flex: 0 0 300px; background: var(--tint); border-radius: 16px; padding: 26px 26px 24px; }
.mo-take-k { font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; letter-spacing: .18em;
             text-transform: uppercase; color: var(--primary); }
.mo-take-text { font-family: var(--font-body); font-weight: 700; font-size: 17px; line-height: 1.6;
                color: var(--ink); margin-top: 14px; }

/* ===== two_col / comparison ===== */
.mo-cols { width: 100%; display: flex; gap: 28px; align-items: stretch; }
.mo-col-card { flex: 1 1 0; border-radius: 16px; padding: 28px 30px 24px; display: flex; flex-direction: column; }
.mo-col-h { font-family: var(--font-display); font-weight: 400; font-size: 24px; color: var(--ink); }
.mo-col-bar { width: 34px; height: 5px; border-radius: 3px; margin-top: 14px; }
.mo-col-points { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: space-evenly; margin-top: 8px; }
.mo-col-row { display: flex; align-items: flex-start; gap: 13px; }
.mo-col-mark { width: 8px; height: 8px; border-radius: 50%; margin-top: 8px; flex: 0 0 auto; }
.mo-col-text { font-family: var(--font-body); font-size: 15.5px; line-height: 1.55; color: var(--ink); }

/* ===== process（渐变胶囊步骤,icon 截图烘焙） ===== */
.mo-steps { width: 100%; display: flex; gap: 28px; align-items: stretch; }
.mo-step { flex: 1 1 0; display: flex; flex-direction: column; }
.mo-step-chip { width: 96px; height: 30px; border-radius: 15px; display: flex; align-items: center;
                justify-content: center; background: linear-gradient(135deg, var(--primary), var(--primary-2));
                font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .14em;
                color: #FFFFFF; }
.mo-step-title { font-family: var(--font-body); font-weight: 700; font-size: 17px; margin-top: 18px; }
.mo-step-desc { font-family: var(--font-body); font-size: 13.5px; line-height: 1.55; color: var(--muted); margin-top: 9px; }
.mo-step-rule { width: 100%; height: 1px; background: var(--hairline); margin-top: 16px; }

/* ===== icon_grid ===== */
.mo-grid { flex: 1 1 auto; display: grid; grid-template-columns: repeat(3, 1fr);
           column-gap: 24px; row-gap: 20px; margin-top: 22px; min-height: 0; }
.mo-grid.two-row { grid-template-rows: repeat(2, 1fr); }
.mo-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.mo-cell { background: var(--surface); border-radius: 16px; padding: 18px 22px 15px;
           position: relative; display: flex; flex-direction: column; min-height: 0; }
.mo-cell-ico { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center;
               justify-content: center; color: #FFFFFF; flex: 0 0 auto;
               background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-cell-num { position: absolute; right: 20px; top: 17px; font-family: var(--font-mono);
               font-size: 11px; color: var(--muted); }
.mo-cell-title { font-family: var(--font-body); font-weight: 700; font-size: 16px; margin-top: 12px; }
.mo-cell-sub { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .12em;
               text-transform: uppercase; color: var(--muted); margin-top: 4px; }
.mo-cell-line { font-family: var(--font-body); font-size: 13px; line-height: 1.5; color: var(--ink); margin-top: 4px; }
.mo-cell-line.first { margin-top: 10px; }
.mo-cell-punch { font-family: var(--font-body); font-weight: 700; font-size: 13px;
                 color: var(--primary); margin-top: auto; padding-top: 8px; }

/* ===== timeline ===== */
.mo-tl { position: relative; width: 100%; }
.mo-tl-axis { position: absolute; left: 0; right: 0; top: 42px; height: 1px; background: var(--hairline); }
.mo-tl-row { display: flex; gap: 20px; }
.mo-tl-item { flex: 1 1 0; display: flex; flex-direction: column; align-items: flex-start; }
.mo-tl-year { font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; color: var(--primary-2); }
.mo-tl-node { width: 13px; height: 13px; border-radius: 50%; margin-top: 21px;
              background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-tl-title { font-family: var(--font-body); font-weight: 700; font-size: 16px; margin-top: 20px; }
.mo-tl-desc { font-family: var(--font-body); font-size: 13px; line-height: 1.5; color: var(--muted); margin-top: 8px; }

/* ===== table ===== */
.mo-table { width: 100%; height: 100%; display: flex; flex-direction: column; }
.mo-trow { display: flex; flex: 1 1 0; align-items: center; }
.mo-trow.h-row { flex: 0 0 auto; padding-bottom: 10px; }
.mo-trule { flex: 0 0 auto; width: 100%; height: 1px; background: var(--hairline); }
.mo-trule.strong { height: 2px; background: var(--ink); }
.mo-tcell { flex: 1 1 0; padding: 8px 14px 8px 0; display: flex; align-items: center; min-width: 0; }
.mo-tcell-h { font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .14em;
              text-transform: uppercase; color: var(--primary); }
.mo-tcell-t { font-family: var(--font-body); font-size: 15px; line-height: 1.4; color: var(--ink); }
.mo-tcell-t.lead-col { font-weight: 700; }

/* ===== pillars ===== */
.mo-pillars { width: 100%; display: flex; gap: 28px; align-items: stretch; }
.mo-pillar { flex: 1 1 0; display: flex; flex-direction: column; background: var(--surface);
             border-radius: 16px; padding: 24px 26px 20px; position: relative; overflow: hidden; }
.mo-pillar-cap { position: absolute; left: 0; top: 0; width: 100%; height: 6px;
                 background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-pillar-h { font-family: var(--font-display); font-weight: 400; font-size: 21px; margin-top: 8px; }
.mo-pillar-tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em;
                 text-transform: uppercase; color: var(--muted); margin-top: 6px; }
.mo-pillar-row { display: flex; align-items: flex-start; gap: 11px; margin-top: 13px; }
.mo-pillar-mark { width: 7px; height: 7px; border-radius: 50%; margin-top: 8px; flex: 0 0 auto;
                  background: var(--primary-2); }
.mo-pillar-text { font-family: var(--font-body); font-size: 14px; line-height: 1.5; color: var(--ink); }

/* ===== quote ===== */
.mo-quote-frame { position: absolute; inset: 0; padding: 90px 110px; display: flex;
                  flex-direction: column; justify-content: center; align-items: center; }
.mo-quote-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline;
                max-width: 1020px; row-gap: 10px; }
.mo-quote-text { font-family: var(--font-display); font-weight: 400; font-size: 42px; line-height: 1.4;
                 color: var(--ink); text-align: center; }
.mo-quote-attr { font-family: var(--font-mono); font-size: 12px; letter-spacing: .16em;
                 text-transform: uppercase; color: var(--muted); margin-top: 34px; }

/* ===== cover / closing ===== */
.mo-cover-frame { position: absolute; inset: 0; padding: 40px 64px 36px; display: flex; flex-direction: column; }
.mo-cover-title { font-family: var(--font-display); font-weight: 400; font-size: 64px; line-height: 1.14;
                  letter-spacing: .01em; color: var(--ink); }
.mo-cover-chip { position: relative; height: 40px; margin-top: 26px; align-self: flex-start; }
.mo-cover-chip-bg { position: absolute; inset: 0; border-radius: 20px;
                    background: linear-gradient(135deg, var(--primary), var(--primary-2)); }
.mo-cover-chip-t { position: absolute; left: 22px; right: 22px; top: 50%; transform: translateY(-50%);
                   line-height: 1.3; font-family: var(--font-body); font-weight: 700;
                   font-size: 15px; color: #FFFFFF; }
.mo-close-title { font-family: var(--font-display); font-weight: 400; font-size: 72px; line-height: 1.16;
                  color: var(--ink); }

/* body text that may run long must wrap (overrides the single-line default) */
.mo-vtext, .mo-col-text, .mo-tcell-t, .mo-cell-line, .mo-tl-desc, .mo-step-desc,
.mo-pillar-text, .mo-take-text, .mo-quote-text, .mo-sowhat-t, .mo-hero-sub, .mo-hero-flabel,
.mo-toc-desc, .mo-sec-sub, .mo-sub { white-space: normal; }
/* wrapping body text inside flex rows must fill + be allowed to shrink */
.mo-vtext, .mo-col-text, .mo-tcell-t, .mo-pillar-text, .mo-hero-flabel { flex: 1 1 auto; min-width: 0; }
</style>
</head>
<body class="slide {% block klass %}{% endblock %}">
{% block bg %}<div data-ppt="rect" data-ppt-z="-30" style="position:absolute;inset:0;background:var(--bg-content);"></div>{% endblock %}
{% block frame %}{% endblock %}
</body>
</html>
