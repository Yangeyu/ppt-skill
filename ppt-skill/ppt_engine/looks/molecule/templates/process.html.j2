{% extends "base.html.j2" %}
{% block frame %}
{# 步骤/方法 — 渐变胶囊 STEP 徽 + 标题 + 描述 #}
<div class="mo-frame">
  {% include "_head.html.j2" %}
  <div class="mo-body" style="align-items:center;">
    <div class="mo-steps">
      {% for st in d.steps %}
      <div class="mo-step">
        <div data-ppt="icon" class="mo-step-chip">STEP {{ '%02d' % loop.index }}</div>
        <div data-ppt="text" class="mo-step-title">{{ st.title }}</div>
        {% if st.desc %}<div data-ppt="text" class="mo-step-desc">{{ st.desc }}</div>{% endif %}
        <div data-ppt="rect" class="mo-step-rule"></div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% include "_sowhat.html.j2" %}
</div>
{% include "_foot.html.j2" %}
{% endblock %}
