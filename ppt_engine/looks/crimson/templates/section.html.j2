{% extends "base.html.j2" %}
{% block bg %}{% endblock %}
{% block frame %}
{# 章节幕（C0）—— 深红满屏：巨号宋体章节号 + 反白章节题,底部发丝线闭合 #}
<div data-ppt="rect" data-ppt-z="-20" style="position:absolute;inset:0;background:{{ colors['accent'] }};"></div>
<div data-ppt="rect" style="position:absolute;left:0;top:0;width:100%;height:8px;background:{{ colors['primary-2'] }};"></div>
<div class="cs-frame">
  <div style="display:flex;justify-content:space-between;">
    <div data-ppt="text" class="cs-sub" style="color:rgba(255,255,255,.66);">SECTION {{ d.number }}</div>
    <div data-ppt="text" class="cs-sub" style="color:rgba(255,255,255,.66);">{{ '%02d / %02d'|format(page_no, page_total) if page_total else 'CRIMSON' }}</div>
  </div>
  <div style="flex:1 1 auto;display:flex;align-items:flex-end;gap:52px;min-height:0;padding-bottom:36px;">
    <div data-ppt="text" class="cs-num" style="color:rgba(255,255,255,.28);">{{ d.number }}</div>
    <div style="display:flex;flex-direction:column;padding-bottom:14px;min-width:0;">
      <div data-ppt="rect" style="width:44px;height:3px;background:{{ colors['accent-on'] }};margin-bottom:22px;"></div>
      <div data-ppt="text" class="cs-title" style="color:{{ colors['accent-on'] }};">{{ d.title }}</div>
      {% if d.subtitle %}<div data-ppt="text" class="cs-sub" style="color:rgba(255,255,255,.66);margin-top:16px;">{{ d.subtitle }}</div>{% endif %}
    </div>
  </div>
  <div data-ppt="rect" style="width:100%;height:1px;background:rgba(255,255,255,.30);"></div>
  <div style="display:flex;justify-content:space-between;padding-top:12px;">
    <div data-ppt="text" class="cs-sub" style="color:rgba(255,255,255,.66);">{{ deck_title }}</div>
    <div data-ppt="text" class="cs-sub" style="color:rgba(255,255,255,.66);">CONFIDENTIAL</div>
  </div>
</div>
{% endblock %}
