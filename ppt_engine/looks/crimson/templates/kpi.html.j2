{% extends "base.html.j2" %}
{% block frame %}
<div class="c-frame">
  {% include "_head.html.j2" %}
  <div class="c-body" style="align-items:center;">
    <div class="c-kpis">
      {% for s in d.stats %}
      <div class="c-kpi">
        <div data-ppt="rect" class="c-kpi-rule" {% if loop.first %}style="background:{{ colors['accent'] }};"{% endif %}></div>
        <div data-ppt="text" class="c-etag" style="margin-top:10px;">E{{ '%02d' % loop.index }}</div>
        <div data-ppt="text" class="c-kpi-val" style="margin-top:12px;color:{{ colors['accent'] if loop.first else colors['ink'] }};">{{ s.value }}</div>
        <div data-ppt="text" class="c-kpi-label">{{ s.label }}</div>
        {% if s.delta %}<div data-ppt="text" class="c-kpi-delta">{{ s.delta }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% include "_sowhat.html.j2" %}
</div>
{% include "_foot.html.j2" %}
{% endblock %}
