{% extends "base.html.j2" %}
{% import "_deco.html.j2" as deco %}
{% block bg %}{% endblock %}
{% block frame %}
<!-- sage field; left white-mat photo card with offset deep-green block; right type + stacked facts -->
<div data-ppt="rect" data-ppt-z="-30" style="position:absolute;inset:0;background:{{ colors['sage'] }};"></div>
{{ deco.umbel(20, 30, 0.7, colors['sage-deep']) }}
{{ deco.flower(1180, 490, 0.7, colors['sage-deep'], mirror=True) }}
<!-- photo card -->
<div data-ppt="rect" data-ppt-deco data-ppt-z="-8" style="position:absolute;left:100px;top:148px;width:560px;height:452px;background:{{ colors['accent'] }};"></div>
<div data-ppt="rect" data-ppt-z="-5" style="position:absolute;left:76px;top:124px;width:560px;height:452px;background:{{ colors['card'] }};"></div>
<div data-ppt="image" data-src="{{ hero_img }}" style="position:absolute;left:90px;top:138px;width:532px;height:402px;"></div>
<div data-ppt="text" style="position:absolute;left:90px;top:552px;font-family:var(--font-latin);font-size:9px;letter-spacing:.24em;text-transform:uppercase;color:{{ colors['muted'] }};">MORANDI COLOR STUDY</div>
<!-- right column -->
<div style="position:absolute;left:712px;right:84px;top:0;height:720px;display:flex;flex-direction:column;justify-content:center;">
  {% if d.eyebrow %}
  <div style="display:flex;align-items:center;gap:12px;">
    <div data-ppt="rect" style="width:8px;height:8px;background:{{ colors['on-sage'] }};"></div>
    <div data-ppt="text" style="font-family:var(--font-latin);font-size:11.5px;font-weight:700;letter-spacing:.26em;text-transform:uppercase;color:{{ colors['on-sage'] }};">{{ d.eyebrow }}</div>
  </div>
  {% endif %}
  <div data-ppt="text" style="font-family:var(--font-display);font-weight:400;font-size:40px;line-height:1.25;color:{{ colors['on-sage'] }};margin-top:18px;white-space:normal;">{{ d.title }}</div>
  {% if d.subtitle %}<div data-ppt="text" style="font-family:var(--font-body);font-size:14px;line-height:1.7;color:{{ colors['on-sage-soft'] }};margin-top:16px;white-space:normal;">{{ d.subtitle }}</div>{% endif %}
  {% if d.facts %}
  <div style="margin-top:30px;display:flex;flex-direction:column;">
    {% for f in d.facts %}
    <div style="position:relative;display:flex;align-items:baseline;gap:22px;padding:14px 0;">
      <div data-ppt="rect" style="position:absolute;left:0;right:0;top:0;height:1px;background:{{ colors['hairline-2'] }};"></div>
      <div data-ppt="text" style="font-family:var(--font-display);font-weight:400;font-size:34px;line-height:1;color:{{ colors['bg'] if loop.last else colors['on-sage'] }};min-width:170px;">{{ f.value }}</div>
      <div data-ppt="text" style="font-family:var(--font-latin);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:{{ colors['on-sage-muted'] }};">{{ f.label }}</div>
    </div>
    {% endfor %}
    <div data-ppt="rect" style="width:100%;height:1px;background:{{ colors['hairline-2'] }};"></div>
  </div>
  {% endif %}
</div>
<div style="position:absolute;left:96px;right:84px;bottom:34px;display:flex;justify-content:space-between;">
  {% if d.footer %}<div data-ppt="text" style="font-family:var(--font-latin);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:{{ colors['on-sage-muted'] }};">{{ d.footer }}</div>{% else %}<div></div>{% endif %}
  <div data-ppt="text" style="font-family:var(--font-latin);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:{{ colors['on-sage-muted'] }};">FRESH · MORANDI</div>
</div>
{% endblock %}
