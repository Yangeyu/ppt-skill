<div class="m-head">
  <div class="m-head-row">
    <div class="m-kick-wrap">
      <div data-ppt="rect" class="m-kick-sq"></div>
      {% if d.eyebrow %}<div data-ppt="text" class="m-kicker">{{ d.eyebrow }}</div>{% endif %}
    </div>
    <div data-ppt="text" class="m-mark">MORANDI · FRESH</div>
  </div>
  <div data-ppt="text" class="m-title">{{ d.title }}</div>
  {% if d.subtitle is defined and d.subtitle %}<div data-ppt="text" class="m-sub">{{ d.subtitle }}</div>{% endif %}
  <div class="m-rule-wrap">
    <div data-ppt="rect" class="m-rule"></div>
    <div data-ppt="rect" class="m-tick"></div>
    <div data-ppt="rect" class="m-tick-2"></div>
  </div>
</div>
