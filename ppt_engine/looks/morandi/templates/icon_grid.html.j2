{% extends "base.html.j2" %}
{% block frame %}
{% set n = d.cards|length %}
<div class="m-frame">
  {% include "_head.html.j2" %}
  <div class="m-grid" {% if n <= 4 %}style="grid-template-columns:repeat({{ n if n <= 3 else 2 }}, 1fr);grid-template-rows:repeat({{ 1 if n <= 3 else 2 }}, 1fr);"{% endif %}>
    {% for card in d.cards %}
    {# white cards on cream, sage top band; exactly ONE deep-green card (the last) #}
    {% set on_accent = loop.last %}
    {% set fg = colors['on-accent'] if on_accent else colors['ink'] %}
    {% set mut = colors['on-accent-muted'] if on_accent else colors['muted'] %}
    <div class="m-cell">
      <div data-ppt="rect" class="m-gcard" style="background:{{ colors['accent'] if on_accent else colors['card'] }};">
        <div data-ppt="rect" class="m-gband" style="background:{{ colors['accent-2'] if on_accent else colors['sage'] }};"></div>
        <div data-ppt="icon" class="m-gico" style="color:{{ colors['on-accent'] if on_accent else colors['accent'] }};">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">{{ icons[card.icon]|safe }}</svg>
        </div>
        <div data-ppt="text" class="m-gnum" style="color:{{ mut }};">{{ '%02d' % loop.index }}</div>
        <div class="m-gmeat">
          <div data-ppt="text" class="m-gtitle" style="color:{{ fg }};">{{ card.title }}</div>
          {% if card.subtitle %}<div data-ppt="text" class="m-gsub" style="color:{{ mut }};">{{ card.subtitle }}</div>{% endif %}
          {% for ln in card.lines %}
          <div data-ppt="text" class="m-gline {{ 'first' if loop.first else '' }}" style="color:{{ colors['on-accent'] if on_accent else colors['secondary'] }};">{{ ln }}</div>
          {% endfor %}
          {% if card.punch %}<div data-ppt="text" class="m-gpunch" style="color:{{ colors['accent-2'] if on_accent else colors['terra-deep'] }};">{{ card.punch }}</div>{% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% include "_foot.html.j2" %}
</div>
{% endblock %}
