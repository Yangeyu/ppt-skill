{% extends "base.html.j2" %}
{% from "_brush.html.j2" import corners with context %}
{% block frame %}
{# 中线对开 — 左驼色标记（中性侧），右陶土橙标记（焦点侧） #}
{{ corners(170) }}
<div class="m-frame">
  {% include "_head.html.j2" %}
  <div class="m-body">
    <div class="m-cmp">
      <div class="m-cmp-div" data-ppt="rect"></div>
      {% for col, mark in [(d.left, colors['tan']), (d.right, colors['accent'])] %}
      <div class="m-cmp-col {{ 'a' if loop.first else 'b' }}">
        <div data-ppt="text" class="m-cmp-h">{{ col.heading }}</div>
        <div data-ppt="rect" class="m-cmp-bar" style="background:{{ mark }};"></div>
        <div class="m-cmp-points">
          {% for pt in col.points %}
          <div class="m-cmp-row">
            <div data-ppt="rect" class="m-cmp-mark" style="background:{{ mark }};"></div>
            <div data-ppt="text" class="m-cmp-text">{{ pt }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
