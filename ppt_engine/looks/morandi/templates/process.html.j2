{% extends "base.html.j2" %}
{% import "_deco.html.j2" as deco %}
{% block frame %}
<div class="m-frame">
  {% include "_head.html.j2" %}
  <div class="m-body">
    <div class="m-proc">
      <div data-ppt="rect" class="m-proc-axis"></div>
      <div class="m-proc-row">
        {% for st in d.steps %}
        <div class="m-proc-item">
          <div data-ppt="text" class="m-proc-num">STEP {{ '%02d' % loop.index }}</div>
          {{ deco.node(20, colors['terra-deep'] if loop.last else colors['accent'], colors['accent'] if loop.last else colors['sage'], 'margin-top:44px;transform:translateY(11px);') }}
          <div data-ppt="text" class="m-proc-title">{{ st.title }}</div>
          <div data-ppt="text" class="m-proc-desc">{{ st.desc }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% include "_foot.html.j2" %}
</div>
{% endblock %}
