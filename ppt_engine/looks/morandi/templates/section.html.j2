{% extends "base.html.j2" %}
{% import "_deco.html.j2" as deco %}
{% block bg %}{% endblock %}
{% block frame %}
<!-- full sage; left cream specimen card with floral + ghost number, right statement -->
<div data-ppt="rect" data-ppt-z="-30" style="position:absolute;inset:0;background:{{ colors['sage'] }};"></div>
{{ deco.umbel(1130, 40, 0.75, colors['sage-deep'], mirror=True) }}
{{ deco.flower(30, 500, 0.75, colors['sage-deep']) }}
<!-- specimen card: offset deep-green block behind a cream plate -->
<div data-ppt="rect" data-ppt-deco data-ppt-z="-8" style="position:absolute;left:118px;top:172px;width:400px;height:400px;background:{{ colors['accent'] }};"></div>
<div data-ppt="rect" data-ppt-z="-5" style="position:absolute;left:96px;top:150px;width:400px;height:400px;background:{{ colors['paper'] }};"></div>
{{ deco.flower(200, 220, 1.3, colors['sage-deep'], z=-2) }}
{{ deco.blobline(150, 420, 100, colors['hairline-2'], z=-2) }}
<div data-ppt="text" data-ppt-deco style="position:absolute;left:132px;top:170px;font-family:var(--font-latin);font-size:88px;font-weight:700;letter-spacing:.02em;color:{{ colors['paper-2'] }};">{{ d.number or '01' }}</div>
<!-- right statement -->
<div style="position:absolute;left:600px;right:96px;top:0;height:720px;display:flex;flex-direction:column;justify-content:center;">
  <div style="display:flex;align-items:center;gap:12px;">
    <div data-ppt="rect" style="width:34px;height:34px;background:{{ colors['accent'] }};"></div>
    <div data-ppt="text" style="font-family:var(--font-latin);font-size:15px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:{{ colors['on-sage'] }};">PART {{ d.number or '01' }}</div>
  </div>
  <div data-ppt="text" style="font-family:var(--font-display);font-weight:400;font-size:52px;line-height:1.2;color:{{ colors['on-sage'] }};margin-top:26px;white-space:normal;">{{ d.title }}</div>
  <div data-ppt="rect" style="width:52px;height:3px;background:{{ colors['accent-2'] }};margin-top:26px;"></div>
  {% if d.subtitle %}<div data-ppt="text" style="font-family:var(--font-body);font-size:15px;line-height:1.7;color:{{ colors['on-sage-soft'] }};margin-top:22px;max-width:520px;white-space:normal;">{{ d.subtitle }}</div>{% endif %}
</div>
<div data-ppt="rect" style="position:absolute;left:96px;right:96px;bottom:64px;height:1px;background:{{ colors['hairline-2'] }};"></div>
<div style="position:absolute;left:96px;right:96px;bottom:36px;display:flex;justify-content:space-between;">
  <div data-ppt="text" style="font-family:var(--font-latin);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:{{ colors['on-sage-muted'] }};">SECTION {{ d.number or '—' }}</div>
  <div data-ppt="text" style="font-family:var(--font-latin);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:{{ colors['on-sage-muted'] }};">MORANDI · FRESH</div>
</div>
{% endblock %}
