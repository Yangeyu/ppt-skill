{% extends "base.html.j2" %}
{% block frame %}
{# S11 Horizontal Timeline — 1px 墨轴 + 方形节点;最后一站 accent 点亮 #}
<div class="s-frame">
  {% include "_head.html.j2" %}
  <div class="s-body" style="align-items:center;">
    <div class="s-tl">
      <div data-ppt="rect" class="s-tl-axis"></div>
      <div class="s-tl-row">
        {% for m in d.milestones %}
        <div class="s-tl-item">
          <div data-ppt="text" class="s-tl-year" {% if loop.last %}style="color:{{ colors['accent'] }};"{% endif %}>{{ m.year }}</div>
          <div data-ppt="rect" class="s-tl-node" {% if loop.last %}style="background:{{ colors['accent'] }};width:13px;height:13px;margin-top:20px;"{% endif %}></div>
          <div data-ppt="text" class="s-tl-title">{{ m.title }}</div>
          {% if m.desc %}<div data-ppt="text" class="s-tl-desc">{{ m.desc }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
