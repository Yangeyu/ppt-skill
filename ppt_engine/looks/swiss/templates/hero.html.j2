{% extends "base.html.j2" %}
{% block frame %}
{# S22 Image Hero — 顶部全宽图片条(黑白双色调) + 下方左对齐大标题 + 底部 KPI 三列 #}
<div class="sh-strip">
  <div data-ppt="image" data-ppt-z="-20" data-src="{{ hero_img }}" style="position:absolute;inset:0;"></div>
</div>
<div data-ppt="rect" style="position:absolute;left:0;top:268px;width:100%;height:2px;background:{{ colors['ink'] }};"></div>
<div class="sh-frame">
  <div class="s-kick-row">
    {% if d.eyebrow %}<div data-ppt="text" class="s-kicker">{{ d.eyebrow }}</div>{% endif %}
    <div data-ppt="text" class="s-chrome-t" style="margin-left:auto;">{{ '%02d / %02d'|format(page_no, page_total) if page_total else 'SWISS INTERNATIONAL' }}</div>
  </div>
  <div class="sh-title-row">
    {% for seg in d.title|marksplit %}
    <div data-ppt="text" class="sh-title"{% if seg.mark %} style="color:{{ colors['accent'] }};"{% endif %}>{{ seg.text }}</div>
    {% endfor %}
  </div>
  {% if d.subtitle %}<div data-ppt="text" class="sh-sub">{{ d.subtitle }}</div>{% endif %}
  {% if d.facts %}
  <div class="sh-facts">
    {% for f in d.facts %}
    <div class="sh-fact">
      <div data-ppt="rect" class="sh-fact-rule" {% if loop.first %}style="background:{{ colors['accent'] }};height:2px;"{% endif %}></div>
      <div data-ppt="text" class="sh-fact-val" {% if loop.first %}style="color:{{ colors['accent'] }};"{% endif %}>{{ f.value }}</div>
      <div data-ppt="text" class="sh-fact-label">{{ f.label }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% set foot_left = d.footer or deck_title %}
{% include "_foot.html.j2" %}
{% endblock %}
