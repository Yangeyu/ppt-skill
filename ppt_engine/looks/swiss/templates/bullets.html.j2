{% extends "base.html.j2" %}
{% block frame %}
<div class="s-frame">
  {% include "_head.html.j2" %}
  <div class="s-body">
    <div class="s-vlist">
      {% for b in d.bullets %}
      <div class="s-vitem">
        <div class="s-vrow">
          <div data-ppt="text" class="s-vnum">{{ '%02d' % loop.index }}</div>
          {% if b.emphasis %}<div data-ppt="rect" class="s-vbar"></div>{% endif %}
          <div data-ppt="text" class="s-vtext {{ 'em' if b.emphasis else '' }}">{{ b.text }}</div>
        </div>
        {% if not loop.last %}<div data-ppt="rect" class="s-vrule"></div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% include "_foot.html.j2" %}
{% endblock %}
