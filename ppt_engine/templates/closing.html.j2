{% extends "base.html.j2" %}
{% block klass %}dark{% endblock %}
{% block bg %}{% endblock %}
{% block frame %}
<div data-ppt="rect" data-ppt-z="-20" data-grad="{{ colors['bg'][1:] }},{{ colors['bg-2'][1:] }},145"
     style="position:absolute;inset:0;background:linear-gradient(145deg,{{ colors['bg'] }},{{ colors['bg-2'] }});"></div>
<div class="closing-frame">
  <div data-ppt="text" class="closing-title">{{ d.title }}</div>
  <div data-ppt="rect" class="closing-bar"></div>
  {% if d.subtitle %}<div data-ppt="text" class="closing-sub">{{ d.subtitle }}</div>{% endif %}
  {% if d.contact %}<div data-ppt="text" class="closing-contact">{{ d.contact }}</div>{% endif %}
</div>
{% endblock %}
