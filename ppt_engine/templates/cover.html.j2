{% extends "base.html.j2" %}
{% block frame %}
<div class="cover-frame">
  <div>
    {% if d.eyebrow %}<div data-ppt="text" class="cover-kicker">{{ d.eyebrow }}</div>{% endif %}
    <div data-ppt="rect" class="cover-topline"></div>
  </div>
  <div class="cover-mid">
    <div data-ppt="rect" class="cover-bar"></div>
    <div data-ppt="text" class="cover-title">{{ d.title }}</div>
    {% if d.subtitle %}<div data-ppt="text" class="cover-sub">{{ d.subtitle }}</div>{% endif %}
  </div>
  <div>
    <div data-ppt="rect" class="cover-botline"></div>
    {% if d.footer %}<div data-ppt="text" class="cover-foot">{{ d.footer }}</div>{% endif %}
  </div>
</div>
{% endblock %}
