{% extends "base.html.j2" %}
{% block frame %}
<div class="frame">
  <div class="head">
    {% if d.eyebrow %}<div data-ppt="text" class="kicker">{{ d.eyebrow }}</div>{% endif %}
    <div data-ppt="text" class="h-title">{{ d.title }}</div>
  </div>
  <div data-ppt="rect" class="head-rule"></div>
  <div class="body cols-body">
    <div class="cmp">
      {% for col, clr in [(d.left, 'primary'), (d.right, 'primary-2')] %}
      <div data-ppt="rect" class="cmp-card">
        <div data-ppt="text" class="cmp-h">{{ col.heading }}</div>
        <div data-ppt="rect" class="cmp-bar" style="background:var(--{{ clr }});"></div>
        {% for pt in col.points %}
        <div class="prow">
          <div data-ppt="rect" class="pmark" style="background:var(--{{ clr }});"></div>
          <div data-ppt="text" class="ptext">{{ pt }}</div>
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
