{% extends "base.html.j2" %}
{% block frame %}
<div class="frame">
  <div class="head">
    {% if d.eyebrow %}<div data-ppt="text" class="kicker">{{ d.eyebrow }}</div>{% endif %}
    <div data-ppt="text" class="h-title">{{ d.title }}</div>
  </div>
  <div data-ppt="rect" class="head-rule"></div>
  <div class="body kpi-body">
    <div class="kpi">
      {% for s in d.stats %}
      <div class="kpi-col">
        <div data-ppt="rect" class="kpi-top"></div>
        <div data-ppt="rect" class="kpi-tick"></div>
        <div data-ppt="text" class="kpi-value">{{ s.value }}</div>
        <div data-ppt="text" class="kpi-label">{{ s.label }}</div>
        {% if s.delta %}<div data-ppt="text" class="kpi-delta {{ s.delta_dir }}">{{ s.delta }}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}
