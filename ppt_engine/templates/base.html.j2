<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<style>
{% if fonts %}{% for fam in fonts.families %}
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 400; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.regular_b64 }}) format("truetype"); }
@font-face { font-family: "{{ fam.typeface }}"; font-weight: 700; font-style: normal;
  src: url(data:font/ttf;base64,{{ fam.bold_b64 }}) format("truetype"); }
{% endfor %}{% endif %}
{{ css_vars|safe }}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
.slide {
  width: 1280px; height: 720px; position: relative; overflow: hidden;
  background: var(--bg-content); color: var(--ink);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased; text-rendering: geometricPrecision;
}
.slide.dark { background: var(--bg); color: var(--on-dark); }
[data-ppt] { box-sizing: border-box; }
[data-ppt="text"] { margin: 0; padding: 0; }

/* ---- shared content masthead ---- */
.frame { position: absolute; inset: 0; padding: 58px 96px 60px; display: flex; flex-direction: column; }
.head { flex: 0 0 auto; }
.kicker { font-size: 13px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--primary); }
.h-title { font-family: var(--font-serif); font-size: 38px; font-weight: 700; line-height: 1.14; color: var(--ink); margin-top: 12px; letter-spacing: .005em; }
.head-rule { width: 100%; height: 1px; background: var(--hairline); margin-top: 22px; flex: 0 0 auto; }
.body { flex: 1 1 auto; display: flex; margin-top: 38px; }

/* ---- cover (paper) ---- */
.cover-frame { position: absolute; inset: 0; padding: 70px 96px 64px; display: flex; flex-direction: column; }
.cover-top { display: flex; justify-content: space-between; align-items: baseline; }
.cover-kicker { font-size: 14px; font-weight: 600; letter-spacing: .26em; text-transform: uppercase; color: var(--primary); }
.cover-mark { font-size: 13px; font-weight: 500; letter-spacing: .14em; color: var(--muted); }
.cover-topline { width: 100%; height: 1px; background: var(--hairline); margin-top: 18px; }
.cover-mid { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; }
.cover-bar { width: 60px; height: 4px; background: var(--primary); margin-bottom: 32px; }
.cover-title { font-family: var(--font-serif); font-size: 84px; font-weight: 700; line-height: 1.04; color: var(--ink); letter-spacing: -.01em; max-width: 1010px; }
.cover-sub { font-size: 21px; font-weight: 400; line-height: 1.5; color: var(--muted); margin-top: 30px; max-width: 720px; }
.cover-botline { width: 100%; height: 1px; background: var(--hairline); margin-bottom: 18px; }
.cover-foot { font-size: 14px; font-weight: 500; letter-spacing: .04em; color: var(--muted); }

/* ---- section / chapter break (ink) ---- */
.section-frame { position: absolute; inset: 0; padding: 80px 96px; display: flex; flex-direction: column; justify-content: center; }
.section-ghost { position: absolute; right: 56px; bottom: -64px; font-family: var(--font-serif); font-weight: 700; font-size: 400px; line-height: .8; color: #332B25; }
.section-num { font-size: 15px; font-weight: 600; letter-spacing: .24em; color: var(--primary); }
.section-title { font-family: var(--font-serif); font-size: 62px; font-weight: 700; line-height: 1.08; color: var(--on-dark); margin-top: 18px; max-width: 860px; }
.section-bar { width: 56px; height: 4px; background: var(--primary); margin-top: 28px; }
.section-sub { font-size: 20px; line-height: 1.5; color: var(--on-dark-muted); margin-top: 26px; max-width: 680px; }

/* ---- toc (paper) ---- */
.body.toc-body { align-items: center; }
.toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 84px; width: 100%; }
.toc-item { padding: 4px 0 0; }
.toc-row { display: flex; align-items: baseline; gap: 24px; }
.toc-num { font-family: var(--font-serif); font-size: 30px; font-weight: 700; color: var(--primary); line-height: 1; }
.toc-title { font-size: 21px; font-weight: 500; color: var(--ink); }
.toc-line { width: 100%; height: 1px; background: var(--hairline); margin-top: 20px; }

/* ---- kpi (paper) — top rule + 朱砂 tick + serif number ---- */
.body.kpi-body { align-items: center; }
.kpi { display: flex; gap: 32px; width: 100%; }
.kpi-col { flex: 1 1 0; position: relative; }
.kpi-top { width: 100%; height: 2px; background: var(--hairline); }
.kpi-tick { position: absolute; left: 0; top: 0; width: 30px; height: 2px; background: var(--primary); }
.kpi-value { font-family: var(--font-serif); font-size: 60px; font-weight: 700; line-height: 1; color: var(--ink); margin-top: 24px; letter-spacing: -.01em; }
.kpi-label { font-size: 16px; font-weight: 500; color: var(--muted); margin-top: 16px; }
.kpi-delta { font-size: 14px; font-weight: 700; margin-top: 9px; }
.kpi-delta.up { color: var(--pos); } .kpi-delta.down { color: var(--neg); } .kpi-delta.flat { color: var(--muted); }

/* ---- bullets (paper) ---- */
.body.bullets-body { align-items: center; }
.bullets { display: flex; flex-direction: column; gap: 25px; width: 100%; }
.brow { display: flex; align-items: flex-start; gap: 20px; }
.bmark { width: 8px; height: 8px; background: var(--primary); margin-top: 11px; flex: 0 0 auto; }
.btext { font-size: 21px; line-height: 1.55; color: var(--ink); font-weight: 400; flex: 1 1 auto; }
.btext.em { font-weight: 700; }

/* ---- two columns (paper) ---- */
.body.cols-body { align-items: flex-start; }
.cols { display: flex; gap: 84px; width: 100%; }
.col { flex: 1 1 0; }
.col-h { font-family: var(--font-serif); font-size: 24px; font-weight: 700; color: var(--ink); }
.col-bar { width: 40px; height: 3px; background: var(--primary); margin: 14px 0 24px; }
.prow { display: flex; align-items: flex-start; gap: 15px; margin-bottom: 18px; }
.pmark { width: 6px; height: 6px; background: var(--primary); margin-top: 9px; flex: 0 0 auto; }
.ptext { font-size: 18px; line-height: 1.55; color: var(--ink); flex: 1 1 auto; }

/* ---- comparison (paper) ---- */
.cmp { display: flex; gap: 32px; width: 100%; }
.cmp-card { flex: 1 1 0; background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 32px 34px; }
.cmp-h { font-family: var(--font-serif); font-size: 23px; font-weight: 700; }
.cmp-bar { width: 40px; height: 3px; margin: 14px 0 24px; }

/* ---- process (paper) ---- */
.body.steps-body { align-items: center; }
.steps-wrap { position: relative; width: 100%; }
.steps-line { position: absolute; left: 9%; right: 9%; top: 36px; height: 1px; background: var(--hairline); }
.steps { display: flex; gap: 24px; width: 100%; position: relative; }
.step { flex: 1 1 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
.step-badge { width: 72px; height: 72px; border-radius: 50%; background: var(--bg-content);
              border: 1.5px solid var(--primary); display: flex; align-items: center; justify-content: center; }
.step-icon { width: 33px; height: 33px; color: var(--ink); }
.step-num { font-family: var(--font-serif); font-size: 15px; font-weight: 700; letter-spacing: .12em; color: var(--primary); margin-top: 20px; }
.step-title { font-size: 18px; font-weight: 700; color: var(--ink); margin-top: 7px; }
.step-desc { font-size: 14px; line-height: 1.5; color: var(--muted); margin-top: 9px; max-width: 200px; }

/* ---- chart (paper) ---- */
.body.chart-body { align-items: center; }
.chart-wrap { display: flex; gap: 52px; width: 100%; align-items: center; }
.chart-area { flex: 1 1 0; height: 360px; }
.chart-box { width: 100%; height: 100%; }
.takeaway { flex: 0 0 300px; display: flex; gap: 24px; align-items: flex-start; }
.takeaway-bar { width: 3px; height: 130px; background: var(--primary); flex: 0 0 auto; }
.takeaway-text { font-family: var(--font-serif); font-size: 23px; line-height: 1.5; color: var(--ink); padding-top: 2px; }

/* ---- quote (ink) ---- */
.quote-frame { position: absolute; inset: 0; padding: 86px 120px; display: flex; flex-direction: column; justify-content: center; }
.quote-mark { font-family: var(--font-serif); font-size: 150px; font-weight: 700; color: var(--primary); line-height: .55; height: 72px; }
.quote-text { font-family: var(--font-serif); font-size: 42px; font-weight: 700; line-height: 1.4; color: var(--on-dark); max-width: 1000px; margin-top: 22px; }
.quote-bar { width: 56px; height: 4px; background: var(--primary); margin: 34px 0 20px; }
.quote-attr { font-size: 18px; font-weight: 500; color: var(--on-dark-muted); }

/* ---- closing (ink) ---- */
.closing-frame { position: absolute; inset: 0; padding: 80px; display: flex; flex-direction: column;
                 justify-content: center; align-items: center; text-align: center; }
.closing-title { font-family: var(--font-serif); font-size: 90px; font-weight: 700; line-height: 1; color: var(--on-dark); }
.closing-bar { width: 64px; height: 4px; background: var(--primary); margin-top: 30px; }
.closing-sub { font-size: 21px; line-height: 1.5; color: var(--on-dark-muted); margin-top: 32px; max-width: 700px; }
.closing-contact { font-size: 15px; font-weight: 500; letter-spacing: .05em; color: var(--on-dark-muted); margin-top: 18px; }
</style>
</head>
<body class="slide {% block klass %}{% endblock %}">
{% block bg %}<div data-ppt="rect" data-ppt-z="-20" style="position:absolute;inset:0;background:var(--bg-content);"></div>{% endblock %}
{% block frame %}{% endblock %}
</body>
</html>
