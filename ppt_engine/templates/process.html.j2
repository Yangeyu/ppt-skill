{% extends "base.html.j2" %}
{% block frame %}
<div class="frame">
  <div class="head">
    {% if d.eyebrow %}<div data-ppt="text" class="kicker">{{ d.eyebrow }}</div>{% endif %}
    <div data-ppt="text" class="h-title">{{ d.title }}</div>
  </div>
  <div data-ppt="rect" class="head-rule"></div>
  <div class="body steps-body">
    <div class="steps-wrap">
      <div data-ppt="rect" class="steps-line"></div>
      <div class="steps">
        {% for s in d.steps %}
        <div class="step">
          <div data-ppt="rect" class="step-badge">
            <div data-ppt="icon" class="step-icon">
              <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ icons[s.icon]|safe }}</svg>
            </div>
          </div>
          <div data-ppt="text" class="step-num">{{ '%02d' % loop.index }}</div>
          <div data-ppt="text" class="step-title">{{ s.title }}</div>
          {% if s.desc %}<div data-ppt="text" class="step-desc">{{ s.desc }}</div>{% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
